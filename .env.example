# Database
DB_NAME=maxhack
DB_USER=maxhack_user
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
DATABASE_URL=
BACKEND_PORT=127.0.0.1:8000
STUDENT_PORT=127.0.0.1:3000
ADMIN_PORT=127.0.0.1:3001

# Backend
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# MAX notifications
MAX_API_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=
MAX_INTEGRATION_MODE=mock
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_URL=
MAX_OPEN_APP_TARGET=
MAX_WEBAPP_BASE_URL=http://localhost:3000
MAX_INITDATA_MAX_AGE_SECONDS=3600
AUTO_SEED_DEMO=true

# Frontend
VITE_API_URL=/api
NODE_ENV=production

# Docker build settings
BUILD_TARGET=production
VOLUME_MODE=ro

# Development overrides (uncomment for development)
# BUILD_TARGET=development
# VOLUME_MODE=rw
# DJANGO_DEBUG=True
# NODE_ENV=development
